title: System Context

user: "Dashboard User"
browser: "Browser Client"
frontend: "Frontend Dashboard"
backend: "Backend Runtime"
provider: "Market Data Provider"
watchlist: "Watchlist File"
ops: "Developer / Operator"

user -> browser: uses
browser -> frontend: renders
frontend -> backend: sends commands
backend -> frontend: pushes snapshots
provider -> backend: sends aggregate updates
watchlist -> backend: defines symbols
ops -> backend: checks health/logs
