title: Key Flow: Transactions

user: "Dashboard User"
frontend: "Frontend Dashboard"
api: "Command API"
state: "In-Memory Transaction State"
provider: "Market Data Provider"
publisher: "Snapshot Publisher"

user -> frontend: clicks action
frontend -> api: sends command
api -> state: validates/queues
state -> publisher: emits pending snapshot
provider -> state: provides next symbol update
state -> publisher: fills/emits snapshot
publisher -> frontend: pushes full snapshot
