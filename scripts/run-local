#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "[run-local] error: $1 is required but not found in PATH" >&2
    exit 1
  fi
}

require_command docker

if ! docker compose version >/dev/null 2>&1; then
  echo "[run-local] error: docker compose is required" >&2
  exit 1
fi

cd "${ROOT_DIR}"
exec docker compose up --build --remove-orphans "$@"
